# SchemeSetu Frontend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# Serve scheme/eligibility/bookmark data from local mock data instead of the
# backend API. Auth always goes through the real backend regardless of this flag.
VITE_USE_MOCK_DATA="true"

# Must match the backend's GOOGLE_CLIENT_ID (backend/.env) — required for the
# Google Sign-In button on the Login page to initialize.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional Groq API key, used only by scripts/generate-ui-translations.js
# (a build-time script — never bundled into the browser).
GROQ_API_KEY=your_groq_api_key_here
