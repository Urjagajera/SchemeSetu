# SchemeSetu Backend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/schemesetu

# ── Auth (Sprint 3) ──────────────────────────────────────────
# JWT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── LLM / Translation (Sprint 8+) ────────────────────────────
# GROQ_API_KEY=
