# SchemeSetu Backend — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/schemesetu

# ── Auth ────────────────────────────────────────────────────
# Required. Signs/verifies the session cookie (HS256 JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Required for POST /api/auth/google — must match the frontend's Google OAuth Client ID.
GOOGLE_CLIENT_ID=

# DEV-ONLY: remove before production — demo login bypass.
# Optional. Set to the literal string "true" to enable POST /api/auth/demo-login,
# which logs straight into a fixed seeded test account with no real Google
# credential. This is a SECOND gate on top of NODE_ENV !== 'production' (which
# alone is not enough to enable it) — the route 404s unless both hold. Leave
# unset/false everywhere except your own local dev machine.
# ENABLE_DEMO_LOGIN=true

# ── CORS ────────────────────────────────────────────────────
# Origin the frontend is served from — used to configure CORS + cookie policy.
CLIENT_URL=http://localhost:5173

# ── LLM / Translation (Sprint 8+) ────────────────────────────
# GROQ_API_KEY=
