{
  "name": "schemesetu-backend",
  "version": "1.0.0",
  "description": "SchemeSetu backend — pan-India government scheme eligibility platform",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "ingest:dry-run": "tsx src/ingestion/dryRunParseCsv.ts",
    "ingest:schemes": "tsx src/ingestion/ingestSchemes.ts",
    "ingest:eligibility": "tsx src/ingestion/ingestEligibility.ts",
    "ingest:demographics-dry-run": "tsx src/ingestion/dryRunDemographics.ts",
    "translate:vocabulary": "tsx src/translation/buildVocabulary.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.3.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  }
}
