// Prisma schema — Sprint 6
// User, Scheme, EligibilityCriteria, Category, Tag, and Bookmark models.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(uuid())
  googleId          String     @unique
  email             String     @unique
  name              String?
  profilePictureUrl String?
  bookmarks         Bookmark[]
  profile           Profile?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Scheme {
  id                   String               @id @default(uuid())
  // Prisma Client field names below are @map()'d to the original CSV-derived
  // column names so existing ingested data (4,722 rows) needs no column rename —
  // only the generated client's property names change to match the frontend's
  // Scheme type (name/description/authorityName/sourceUrl).
  sourceUrl            String               @unique @map("link") // maps to CSV "url" column — stable merge key
  name                 String               @map("title")
  authorityName        String               @map("offeredBy") // raw CSV "OFFERED BY" text (e.g. "Ministry Of Finance", "Delhi")
  description          String               @map("details") @db.Text // raw CSV "DETAILS" column
  benefits             String[] // flattened from CSV benefit_1..benefit_15
  documentRequirements String[] // flattened from CSV document_requirement_1..document_requirement_15
  applicationMode      String[] // was String? — CSV analysis showed 10.6% of rows have multiple values (newline- or "&"-separated in source data); array avoids silently dropping the second value
  applicationProcess   String?              @db.Text // raw CSV "APPLICTION PROCESS" column
  eligibilityRawText   String[] // flattened from CSV eligibility_1..eligibility_15, kept verbatim
  eligibilityCriteria  EligibilityCriteria?
  categories           Category[]
  tags                 Tag[]
  bookmarks            Bookmark[]
  translations         SchemeTranslation[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

// One row per scheme + language + field, filled on demand the first time a scheme is viewed in that
// language (see src/translation/). Per-field rows mean one field failing validation never blocks the
// others, and only the missing/stale fields are re-translated. `sourceHash` is a hash of the English
// text the translation was made from, so edited source text is detected and re-translated.
model SchemeTranslation {
  id           String   @id @default(uuid())
  schemeId     String
  scheme       Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  languageCode String // "hi" | "gu"
  field        String // title | description | benefits | eligibility | documents | applicationProcess | summary (card text)
  status       String // "ok" | "failed"
  value        Json? // string, or string[] for benefits/eligibility/documents; null when failed
  sourceHash   String
  model        String? // which model produced it (primary or fallback)
  attempts     Int      @default(1)
  error        String? // why the last attempt failed, when status = "failed"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schemeId, languageCode, field])
  @@index([schemeId, languageCode])
}

model EligibilityCriteria {
  id              String   @id @default(uuid())
  schemeId        String   @unique
  scheme          Scheme   @relation(fields: [schemeId], references: [id])
  ageMin          Int?
  ageMax          Int?
  incomeMinAnnual Int? // rare in the sample data, included for completeness
  incomeMaxAnnual Int? // normalized to ANNUAL
  // Demographic fields below are plain nullable strings, not Prisma enums,
  // deliberately — matching the existing style of Category.level and
  // Scheme.applicationMode (a fixed vocabulary tracked in app code, not a
  // DB enum). Frontend option lists (occupation, social category) change in
  // UI code, not DB code; a Postgres enum would need an ALTER TYPE migration
  // for every new option, while a plain String needs none. `state` in
  // particular can never be a small closed enum (28+ Indian states/UTs, and
  // the frontend itself doesn't treat it as one — Profile.tsx uses a free
  // text input for it). Values are not yet populated for any scheme — see
  // ingestSchemes.ts, which explicitly does not touch this relation.
  gender          String? // "male" | "female" | "other" — restriction on scheme eligibility, if any
  category        String? // social category restriction: "general" | "sc" | "st" | "obc"
  occupation      String? // e.g. "farmer", "student", "entrepreneur" — matches Profile.tsx occupation options
  state           String? // state/UT residency restriction, null = no state restriction (central scheme)
  landOwnership   String? // "yes" | "no" — land ownership requirement, if any
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique // raw OFFERED BY value, e.g. "Ministry Of Finance", "Delhi"
  level     String // "Central" or "State" — populated during a later ingestion sprint via static lookup, NOT this sprint
  stateName String? // populated only when level == "State" — null for central ministries
  schemes   Scheme[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "Entrepreneur", "Insurance", "SC/ST", "Women"
  schemes   Scheme[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Server-side home for what used to live only in the frontend's
// localStorage 'schemesetu_profile' key (src/contexts/AuthContext.tsx) — that
// was a single browser-scoped value shared across every account signed in on
// that browser, a live correctness bug, not just a "doesn't sync across
// devices" gap. Fields mirror UserProfile (src/types/index.ts) exactly, kept
// as plain nullable strings (age, income included) rather than parsed to
// Int, matching the raw string values the frontend form actually submits —
// same style as EligibilityCriteria's demographic fields above. `name` is
// deliberately NOT duplicated here; the profile form's name field updates
// User.name directly instead (confirmed choice, not an oversight). interests
// and profileTags on the frontend type are always identical in current
// usage (Profile.tsx writes the same array to both), so this stores ONE
// array and the API mirrors it into both response keys.
model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  age         String?
  dob         String?
  gender      String?
  occupation  String?
  education   String?
  income      String?
  category    String?
  state       String?
  district    String?
  residence   String? // "rural" | "urban"; collected by the profile form and the guest wizard
  minority    String?
  disability  String?
  farmer      String?
  widow       String?
  veteran     String?
  land        String?
  profileTags String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  schemeId  String
  user      User     @relation(fields: [userId], references: [id])
  scheme    Scheme   @relation(fields: [schemeId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, schemeId]) // a user can only bookmark a given scheme once
}
