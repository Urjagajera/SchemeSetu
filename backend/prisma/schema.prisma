// Prisma schema — Sprint 4
// User, Scheme, EligibilityCriteria, and Category models.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String   @id @default(uuid())
  googleId          String   @unique
  email             String   @unique
  name              String?
  profilePictureUrl String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Scheme {
  id                   String               @id @default(uuid())
  link                 String               @unique // maps to CSV "url" column — stable merge key
  title                String
  offeredBy            String // raw CSV "OFFERED BY" text (e.g. "Ministry Of Finance", "Delhi")
  details              String               @db.Text // raw CSV "DETAILS" column
  benefits             String[] // flattened from CSV benefit_1..benefit_15
  documentRequirements String[] // flattened from CSV document_requirement_1..document_requirement_15
  applicationMode      String[] // was String? — CSV analysis showed 10.6% of rows have multiple values (newline- or "&"-separated in source data); array avoids silently dropping the second value
  applicationProcess   String?              @db.Text // raw CSV "APPLICTION PROCESS" column
  eligibilityRawText   String[] // flattened from CSV eligibility_1..eligibility_15, kept verbatim
  eligibilityCriteria  EligibilityCriteria?
  categories           Category[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model EligibilityCriteria {
  id              String   @id @default(uuid())
  schemeId        String   @unique
  scheme          Scheme   @relation(fields: [schemeId], references: [id])
  ageMin          Int?
  ageMax          Int?
  incomeMinAnnual Int? // rare in the sample data, included for completeness
  incomeMaxAnnual Int? // normalized to ANNUAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique // raw OFFERED BY value, e.g. "Ministry Of Finance", "Delhi"
  level     String // "Central" or "State" — populated during a later ingestion sprint via static lookup, NOT this sprint
  stateName String? // populated only when level == "State" — null for central ministries
  schemes   Scheme[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
